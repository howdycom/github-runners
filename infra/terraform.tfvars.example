# Example Terraform variables configuration
# Copy this file to terraform.tfvars and customize as needed

# Docker daemon connection
# docker_host = "unix:///var/run/docker.sock"
# docker_host = "ssh://youruser@192.168.1.100"
# docker_host = "ssh://youruser@192.168.1.100:2222"   # non-default SSH port

# SSH user for remote hosts. Only needed when docker_host omits the user.
# ssh_user = "youruser"

# Enable/disable stacks
enable_portainer      = true
enable_github_runners = true

# GitHub Actions runner settings
# github_runner_org_url      = "https://github.com/your-org"
# github_runner_token        = "YOUR_REGISTRATION_TOKEN"
# github_runner_heavy_count  = 2
# github_runner_light_count  = 4
# github_runner_heavy_labels = "docker,ubuntu-22.04,heavy"
# github_runner_light_labels = "docker,ubuntu-22.04,light"
# github_runner_name_prefix  = "github-runner"
# github_runner_version      = "2.323.0"

# Host memory tuning (applied during bootstrap)
# zram_size_mib = 8192
# swap_size_gib = 16
