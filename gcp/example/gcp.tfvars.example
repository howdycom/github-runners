# Copy to gcp.tfvars (gitignored) and fill in your own values.
# Do not commit real values: this repository is public.

project_id = "your-ci-project"
# region   = "us-central1"
# zones    = ["us-central1-a", "us-central1-b", "us-central1-c", "us-central1-f"]

github_org                 = "your-org"
github_app_id              = "123456"
github_app_installation_id = "12345678"

# Secret Manager secret IDs in project_id.
github_app_private_key_secret = "github-runners-app-key"
github_webhook_secret_id      = "github-runners-webhook-secret"

# A runner group that public repositories cannot use.
runner_group = "your-runner-group"

# Repositories that use these runners. The reconcile job scans them for
# queued jobs without a VM.
repositories = ["your-repo"]

# Optional settings (machine_type, use_cloud_nat, runner_version and
# others) are inputs of the module, with defaults. Set them in main.tf; see
# ../variables.tf for the full list.
