# Copy to gcp.tfvars (gitignored) and fill in your own values.
# Do not commit real values: this repository is public.

project_id = "your-ci-project"
# region   = "us-central1"
# zones    = ["us-central1-a", "us-central1-b", "us-central1-c", "us-central1-f"]

github_org                 = "your-org"
github_app_id              = "123456"
github_app_installation_id = "12345678"

# Secret Manager secret IDs in project_id.
github_app_private_key_secret = "github-runners-app-key"
github_webhook_secret_secret  = "github-runners-webhook-secret"

# A runner group that public repositories cannot use.
runner_group = "your-runner-group"

# Repositories the reconcile job scans for queued jobs whose webhook was lost.
# repositories = ["your-repo"]

# runner_label          = "gcp-x64"
# machine_type          = "n2d-standard-2"
# disk_size_gb          = 75
# max_vms               = 20
# idle_timeout_minutes  = 15
# max_vm_lifetime_hours = 3
# source_image          = "projects/your-ci-project/global/images/family/github-runner"
# use_cloud_nat         = false
